# Copie para apps/server/.env e ajuste.

PORT=3333
HOST=0.0.0.0
CORS_ORIGIN=*
LOG_LEVEL=info

# PostgreSQL (docker compose up -d postgres). Sem esta variável, os saves do servidor ficam em memória.
DATABASE_URL=postgresql://republica:republica@localhost:5432/republica

# IA generativa (opcional — o jogo funciona 100% sem ela).
# auto = usa Anthropic se ANTHROPIC_API_KEY existir; senão, textos procedurais.
AI_PROVIDER=auto
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5

# Provedor compatível com OpenAI (OpenAI, Ollama, LM Studio). Use AI_PROVIDER=openai-compatible.
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.1
# OPENAI_API_KEY=
