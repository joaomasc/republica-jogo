{
  "name": "republica",
  "version": "0.1.0",
  "private": true,
  "description": "República — simulador político e eleitoral jogável no navegador",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "postinstall": "npm run db:generate -w @republica/server",
    "dev": "concurrently -k -n server,web -c blue,green \"npm run dev -w @republica/server\" \"npm run dev -w @republica/web\"",
    "dev:web": "npm run dev -w @republica/web",
    "dev:server": "npm run dev -w @republica/server",
    "build": "npm run build -w @republica/web && npm run build -w @republica/server",
    "preview": "npm run preview -w @republica/web",
    "deploy:pages": "node scripts/deploy-pages.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "simulate": "tsx packages/game-engine/scripts/batch-simulate.ts",
    "generate:map": "node scripts/generate-map.mjs",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "npm run db:migrate -w @republica/server",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
